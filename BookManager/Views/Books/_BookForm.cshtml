@model Book
<div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
<div class="form-grid">
<div class="field full"><label asp-for="Title"></label><input asp-for="Title" placeholder="Nhập tên sách" /><span asp-validation-for="Title"></span></div>
<div class="field"><label asp-for="Author"></label><input asp-for="Author" /><span asp-validation-for="Author"></span></div>
<div class="field"><label asp-for="Category"></label><input asp-for="Category" list="categories" /><datalist id="categories"><option>Văn học</option><option>Công nghệ</option><option>Khoa học</option><option>Kinh tế</option><option>Tiểu thuyết</option></datalist><span asp-validation-for="Category"></span></div>
<div class="field"><label asp-for="Publisher"></label><input asp-for="Publisher" /><span asp-validation-for="Publisher"></span></div>
<div class="field"><label asp-for="PublishedYear"></label><input asp-for="PublishedYear" type="number" /><span asp-validation-for="PublishedYear"></span></div>
<div class="field"><label asp-for="Price"></label><input asp-for="Price" type="text" inputmode="decimal" placeholder="Ví dụ: 75000" /><span asp-validation-for="Price"></span></div>
<div class="field"><label asp-for="Quantity"></label><input asp-for="Quantity" type="number" /><span asp-validation-for="Quantity"></span></div>
<div class="field full"><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description"></span></div>
</div>
<div class="form-actions"><a asp-action="Index" class="button secondary">Hủy</a><button type="submit" class="button primary">Lưu thông tin</button></div>
