@model BookListViewModel
@{ ViewData["Title"]="Danh mục sách"; }
<div class="page-heading"><div><div class="eyebrow">THƯ VIỆN CỦA BẠN</div><h1>Danh mục sách</h1><p class="muted">Quản lý và sắp xếp những cuốn sách trong thư viện.</p></div><a class="button primary" asp-action="Create">＋ Thêm sách mới</a></div>
<div class="stats"><div class="stat"><span>Tổng đầu sách</span><strong>@Model.TotalBooks.ToString("D2")</strong><small>Đầu sách trong thư viện</small></div><div class="stat"><span>Sách hiện có</span><strong>@Model.TotalQuantity.ToString("N0")</strong><small>Tổng số lượng lưu kho</small></div><div class="stat"><span>Thể loại</span><strong>@Model.Categories.Count.ToString("D2")</strong><small>Những lĩnh vực tri thức</small></div></div>
<section class="panel"><div class="panel-heading"><h2>Tất cả sách <span class="badge">@Model.FilteredCount</span></h2><span class="muted">Trang @Model.Page / @Model.TotalPages</span></div>
<form method="get" class="filters"><label class="search"><span>⌕</span><input name="search" value="@Model.Search" placeholder="Tìm theo tên sách hoặc tác giả…" aria-label="Tìm sách" /></label><select name="category" aria-label="Thể loại"><option value="">Tất cả thể loại</option>@foreach(var c in Model.Categories){<option value="@c" selected="@(c==Model.Category)">@c</option>}</select><button class="button secondary" type="submit">Tìm kiếm</button>@if(Model.Search is not null || Model.Category is not null){<a class="text-link" asp-action="Index">Đặt lại</a>}</form>
<div class="table-scroll"><table><thead><tr><th>TÊN SÁCH / TÁC GIẢ</th><th>THỂ LOẠI</th><th>NĂM</th><th>GIÁ BÁN</th><th>SỐ LƯỢNG</th><th>THAO TÁC</th></tr></thead><tbody>
@foreach(var book in Model.Books){<tr><td><div class="book-cell"><div class="book-cover tone-@(book.Id % 4)">▤</div><div><a class="book-title" asp-action="Details" asp-route-id="@book.Id">@book.Title</a><small>@book.Author</small></div></div></td><td><span class="category-tag">@book.Category</span></td><td>@book.PublishedYear</td><td class="price">@book.Price.ToString("N0") ₫</td><td><span class="quantity">@book.Quantity</span></td><td><div class="actions"><a asp-action="Details" asp-route-id="@book.Id">Xem</a><a asp-action="Edit" asp-route-id="@book.Id">Sửa</a><a class="danger-text" asp-action="Delete" asp-route-id="@book.Id">Xóa</a></div></td></tr>}
@if(Model.Books.Count==0){<tr><td colspan="6" class="empty"><h3>Chưa tìm thấy sách</h3><p>Thử từ khóa khác hoặc thêm sách mới vào thư viện.</p><a asp-action="Create" class="button primary">Thêm sách</a></td></tr>}
</tbody></table></div><div class="pagination"><span class="muted">@Model.FilteredCount kết quả</span><div>@if(Model.Page>1){<a class="button secondary" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-category="@Model.Category">← Trước</a>}@if(Model.Page<Model.TotalPages){<a class="button secondary" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-category="@Model.Category">Sau →</a>}</div></div></section>
