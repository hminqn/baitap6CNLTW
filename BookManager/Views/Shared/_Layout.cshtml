<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · Sổ Sách</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<aside class="sidebar"><a class="brand" asp-controller="Books" asp-action="Index"><span class="brand-icon">▤</span> Sổ Sách<span class="brand-dot">.</span></a><p class="sidebar-label">KHÔNG GIAN QUẢN LÝ</p><a class="nav-active" asp-controller="Books" asp-action="Index"><span>▦</span> Danh mục sách</a><div class="sidebar-bottom"><span class="status-dot"></span> CSDL đã kết nối<br /><small>Book Manager · MVC / Code First</small></div></aside>
<main class="main"><header class="topbar"><span>Thư viện <span class="muted">/ Quản lý sách</span></span><span class="profile">QT <span>Quản trị viên</span></span></header><div class="content">
@if(TempData["Success"] is string message) { <div class="notice" role="status">✓ @message</div> }
@RenderBody()
<footer> Sổ Sách · Không gian nhỏ, tri thức lớn.</footer></div></main>
@await RenderSectionAsync("Scripts", required:false)
</body></html>
